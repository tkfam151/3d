# Copy to .env and fill in. Node 20.12+ loads .env automatically.
PORT=3000
SITE_NAME=Print Desk
# Public address of the site — used for links in emails.
BASE_URL=https://print.example-school.org

# Pickup locations teachers choose between.
PICKUP_LOCATIONS=PU2,PU3
MAX_MODEL_MB=100

# First admin (created on first start if there are no admins yet).
# Or leave blank and visit /admin to create one. Remove the password after first start.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: require this code on the /admin first-run setup screen.
SETUP_CODE=

# Email to teachers.
#   draft (default): each update is written for you; the admin clicks "Open in Gmail"
#                    and presses Send from their own Gmail. No email setup needed.
#   smtp:            the server sends automatically using the SMTP settings below.
EMAIL_MODE=draft
# Only for EMAIL_MODE=smtp. Gmail / Google Workspace: smtp.gmail.com, port 465,
# SMTP_SECURE=true, and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Where data (database + uploaded files) lives. Back this folder up.
DATA_DIR=./data
